{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.Icaro0310/poordjaevin",
  "description": "Typed answers with calibrated confidence for agents. Local-first, no API key.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/Icaro0310/devin-judge",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "poordjaevin",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "environmentVariables": [
        {
          "name": "POORDJAEVIN_BACKEND",
          "description": "Backend: 'acp' (Devin's own model), 'local' (offline NLI) or 'auto'",
          "isRequired": false
        }
      ]
    }
  ]
}